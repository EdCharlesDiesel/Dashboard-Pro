# Template for .streamlit/secrets.toml — copy to secrets.toml and fill in.
# The real secrets.toml is gitignored. Every value is read through
# src/core/secrets.py; pages must never call st.secrets directly.
#
# Each value can also be supplied via environment variable (handy for CI /
# containers); the env var name is shown next to each key.

[api]
FRED_API_KEY    = "your_fred_api_key"      # env: FRED_API_KEY     — https://fred.stlouisfed.org/docs/api/api_key.html
FMP_API_KEY     = "your_fmp_api_key"       # env: FMP_API_KEY      — https://site.financialmodelingprep.com/developer/docs
FINNHUB_API_KEY = "your_finnhub_api_key"   # env: FINNHUB_API_KEY  — https://finnhub.io/dashboard
# Optional — enables AI-written report summaries on the Reports page. Without it,
# Reports falls back to rule-based analytics.
ANTHROPIC_API_KEY = "sk-ant-..."           # env: ANTHROPIC_API_KEY — https://console.anthropic.com/

[database]
host     = "localhost"   # env: DB_HOST
port     = 5432           # env: DB_PORT
dbname   = "trading"      # env: DB_NAME
user     = "postgres"     # env: DB_USER
password = ""             # env: DB_PASSWORD
# Or a single connection string (env: DATABASE_URL), which overrides the above:
# url = "postgresql://user:pass@localhost:5432/trading"

[gmail]
# App password (16 chars) — https://myaccount.google.com/apppasswords (needs 2FA).
sender       = "you@gmail.com"        # env: GMAIL_SENDER
app_password = "abcd efgh ijkl mnop"  # env: GMAIL_APP_PASSWORD
recipient    = "alerts@example.com"   # env: GMAIL_RECIPIENT
