# Dashboard-Pro — runtime environment for the AWS/Neon deploy.
#
#   cp .env.example .env      # then fill in the real values
#
# .env is gitignored AND dockerignored — it is read at container start by
# docker-compose.aws.yml, never baked into the image. Do not commit real values.

# ── Database (Neon) ──────────────────────────────────────────────────────────
# The single connection string from the Neon console → "Connection Details".
# Use the POOLED host (contains "-pooler") for many short-lived connections, and
# keep sslmode=require (Neon mandates TLS). src/core/secrets.py reads
# DATABASE_URL directly, so this one line configures the whole app + worker.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.us-east-1.aws.neon.tech/<dbname>?sslmode=require

# (Alternative to DATABASE_URL — discrete vars, if you prefer:)
# DB_HOST=<endpoint>-pooler.us-east-1.aws.neon.tech
# DB_PORT=5432
# DB_NAME=<dbname>
# DB_USER=<user>
# DB_PASSWORD=<password>

# ── Optional API keys (app degrades gracefully if unset) ─────────────────────
# Claude polish for the Setup Ranker "why this trade" email narrative.
ANTHROPIC_API_KEY=
# FRED macro data (macro pages). Free key from https://fredaccount.stlouisfed.org
FRED_API_KEY=

# ── Email alerts (Grade-A setups) — use a Gmail App Password, NOT your login ──
# Personal Hotmail/Outlook SMTP is disabled by Microsoft; use Gmail here.
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=
