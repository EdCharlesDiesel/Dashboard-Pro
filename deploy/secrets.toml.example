# Copy to /opt/dashboard/.streamlit/secrets.toml on the server and fill in.
# This file is a template only — the real secrets.toml is gitignored.

[database]
# 5432 is correct on a clean server. On the Windows workstation a native
# PostgreSQL owns 5432, so the container publishes 5433 and the local
# secrets.toml must say 5433 - otherwise reads and writes land on two
# different databases with no error.
host = "localhost"
port = 5432
dbname = "DashboardproDBv1"
user = "dashuser"
password = "CHANGE_ME_STRONG"

# Optional: FRED economic-data API key (macro pages). Leave blank to disable.
[api]
fred_api_key = ""

# Optional: Gmail SMTP for the AMD scanner email alerts. Leave blank to disable.
[gmail]
sender = ""
app_password = ""
recipient = ""
