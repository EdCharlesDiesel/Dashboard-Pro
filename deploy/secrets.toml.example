# Copy to /opt/dashboard/.streamlit/secrets.toml on the server and fill in.
# This file is a template only — the real secrets.toml is gitignored.

[database]
host = "localhost"
port = 5432
dbname = "dashboard"
user = "dashuser"
password = "CHANGE_ME_STRONG"

# Optional: FRED economic-data API key (macro pages). Leave blank to disable.
[api]
fred_api_key = ""

# Optional: Gmail SMTP for the AMD scanner email alerts. Leave blank to disable.
[gmail]
sender = ""
app_password = ""
recipient = ""
