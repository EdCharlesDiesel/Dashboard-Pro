src/services/cot_cache/

# Editor atomic-write temp files (accidentally committed before)
*.py.tmp.*
*.tmp.*

.coverage
.claude/settings.local.json

# foglamp architecture scan (.foglamp/). Tracked: scan.json (the map),
# template.html (the renderer), render.py + introspect.py (the tooling).
# Not tracked:
#   scan.lock.json  holds the publish edit token, which is a secret
#   code.json       introspect.py regenerates it from the source tree
#   scan.html       render.py regenerates it from the two JSON files
.foglamp/scan.lock.json
.foglamp/code.json
.foglamp/scan.html

# Obsidian vault — local scratchpad, not project source. Keeps out the
# vendored plugin bundles (~820 KB of minified main.js) and workspace.json,
# which rewrites itself every time a pane moves.
Obsidian/
